# Copy to .env (git-ignored) and fill in. Never put AWS access keys here:
# credentials come from ~/.aws, SSO, or the sandbox environment.

AWS_REGION=us-east-1

# --- Model: Claude Sonnet 5.5 on Amazon Bedrock (US cross-region inference profile) ---
# Use the profile ID (us.…), not the bare model ID: Sonnet 5.5 rejects on-demand calls with the bare ID.
# Used by prototype/backend as BEDROCK_MODEL_ID and by src/askwri (agents) as MODEL_ID.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5
MODEL_ID=us.anthropic.claude-sonnet-5-5
# Sonnet 5.x rejects the temperature setting, so none is sent. Set this only for models that accept it:
# MODEL_TEMPERATURE=0

# --- Knowledge Base (Aurora pgvector). Filled in once the S3 + KB work is done ---
BEDROCK_KB_ID=REPLACE_AFTER_CREATING_KB
KB_ID=REPLACE_AFTER_CREATING_KB
KB_DATA_SOURCE_ID=REPLACE_AFTER_CREATING_KB
CORPUS_BUCKET=askwri-corpus-<account-id>
# HYBRID for Aurora/RDS/OpenSearch (keyword + vector). Use SEMANTIC for S3 Vectors.
KB_SEARCH_TYPE=HYBRID
# vector = customer-managed KB (Aurora pgvector). managed = Bedrock Managed KB.
KB_TYPE=vector

# --- Guardrails: see docs/guardrails-setup.md. Use a NUMBERED version, never DRAFT ---
GUARDRAIL_ID=
GUARDRAIL_VERSION=

# --- Demo mode: serves clearly labeled SAMPLE data when no Knowledge Base exists ---
# Set to false (or remove) once BEDROCK_KB_ID is real.
DEMO_MODE=true

# Retrieval tuning for src/askwri (see eval/run_eval.py --sweep)
MIN_SCORE=0.35
TOP_K=8
# Run without AWS: keyword search over the manifest titles
ASKWRI_MOCK=0
# Demand Radar
RADAR_DB=data/radar.db
RADAR_WEAK_SCORE=0.5
RADAR_RETENTION_DAYS=90

# Web protections (prototype backend). These are the defaults.
# Hostnames the backend answers to. Add your domain when deploying.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Questions per minute from one address on /api/ask, /api/glance and /api/briefing.
RATE_LIMIT_PER_MINUTE=30
